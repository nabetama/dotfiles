# ====================================
# alias
# ====================================
# General
alias ls='ls -FG'
alias ll='ls -tlrh'
alias l='ll'
alias la='ls -tlra'
alias cat='bat --paging=never'
alias c='clear'
alias h='history'

# git
alias gc="git checkout"
alias gcb="git checkout -b"
alias glog="git log -n 30 --oneline --reverse"
alias gdiff='git diff --color=auto'
