[user]
  name = nabetama
  email = mao.nabeta@gmail.com

[credential]
  helper = osxkeychain

[color]
  branch = auto
  diff = auto
  grep = auto
  interactive = auto
  status = auto
  ui = auto

[core]
  editor = nvim
  precomposeunicode = true
  pager = delta
  # グローバルな ignore は既定の ~/.config/git/ignore (xdg パッケージ) を使う

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true
  line-numbers = true
  side-by-side = true

[merge]
  ff = false
  conflictstyle = diff3

[pull]
  rebase = true

[push]
  default = simple

[grep]
  lineNumber = true

[diff]
  algorithm = patience

[ghq]
  root = ~/src

[blame]
  date = relative

[init]
  defaultBranch = main

[commit]
  verbose = true

[alias]
  delete-merged-branches = !git branch --merged | grep -v \\* | xargs -I % git branch -d %
  unstage = reset -q HEAD --

# マシン固有・仕事用の設定 (追跡しない)。後から読んだ値が勝つので最後に置く
[include]
  path = ~/.gitconfig.local
